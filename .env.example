# Example public client configuration. Replace these placeholders locally.
# Keep all private server credentials in your hosting provider's environment settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Hybrid AI provider (OpenAI-compatible APIs). Keep keys server-only; never use NEXT_PUBLIC_.
# Example: https://openrouter.ai/api/v1 or https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Backward-compatible OpenAI fallback if AI_* variables are not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
