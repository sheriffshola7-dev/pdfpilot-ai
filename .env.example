# Copy these examples into your local environment and replace placeholders with your own values.
# Never put a Supabase service-role key in this file or expose it with a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Hybrid AI provider (OpenAI-compatible APIs). Keep keys server-only; never use NEXT_PUBLIC_.
# Example: https://openrouter.ai/api/v1 or https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Backward-compatible OpenAI fallback if AI_* variables are not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
