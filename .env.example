# Public Supabase values; safe for browser use with RLS enabled.
# Copy from Supabase → Project Settings → API. Do not commit real values here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only admin settings. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY must be the Supabase *secret* (service-role) key, not the publishable key.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=

# Hybrid AI provider (OpenAI-compatible APIs). Keep keys server-only; never use NEXT_PUBLIC_.
# Example: https://openrouter.ai/api/v1 or https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Backward-compatible OpenAI fallback if AI_* variables are not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
