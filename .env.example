# Public Supabase values only; safe for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Hybrid AI provider (OpenAI-compatible APIs). Keep keys server-only; never use NEXT_PUBLIC_.
# Example: https://openrouter.ai/api/v1 or https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Backward-compatible OpenAI fallback if AI_* variables are not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Admin dashboard (server-only). Set the real values in Netlify environment variables, never here.
ADMIN_EMAILS=you@example.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
